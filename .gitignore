# Visual Studio / .NET gitignore tailored for .NET 10 and .NET MAUI
# See https://github.com/github/gitignore for more templates

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# MonoDevelop
*.userprefs

# Build results
[Bb]in/
[Oo]bj/
*.ilk
*.meta
*.obj
*.pch
*.pdb
*.ipdb
*.pgc
*.pgd
*.iobj
*.iobj.d
*.iobj.exe
*.iobj.dll
*.iobj.pdb

# Visual Studio temporary files, build results, and
# files generated by popular Visual Studio add-ons.
.vs/
.vscode/
TestResults/

# Visual Studio Code workspace storage
.history/

# NuGet
*.nupkg
# The packages folder can be ignored because of PackageReference
**/packages/*

# NuGet v3
project.lock.json
project.fragment.lock.json
artifacts/

# Dotnet Core
project.assets.json
.nuget/
.nuget/packages/

# Rider
.idea/
*.sln.iml
out/

# User secrets
secrets.json

# Publish outputs
publish/
[pP]ublish/
*/bin/Release*/
*/bin/Debug*/
*/obj/Release*/
*/obj/Debug*/

# Logs
*.log
*.vsix

# OS generated files
ehthumbs.db
Thumbs.db
.DS_Store

# SQLite
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# MAUI / Xamarin / Mobile
# Android
*.apk
*.ap_
*.dex
*.class
*.keystore
*.jks
*.keystore.properties
.gradle/
.gradle
/captures/
*/obj/Debug/android*/
*/obj/Release/android*/
*/bin/Debug/android*/
*/bin/Release/android*/

# iOS
*.app
*.ipa
*.dSYM
*_CodeSignature*
*.mobileprovision
*.plist

# MacCatalyst
*/bin/Debug/net*/ios*/
*/bin/Release/net*/ios*/

# Windows
*.appx
*.msix

# MAUI tooling
.maui/
.maui-cache/

# Rider / ReSharper
_ReSharper*/
*.[Rr]e[sS]harper
resharper.xml
*.DotSettings.user

# Temporary files
*.tmp
*.temp
*.cache

# Visual Studio profiler
*.psess
*.vsp
*.vspx

# Coverage results
*.coverage
*.coveragexml

# Test result files
*.trx

# JetBrains Rider local settings
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/dictionaries
.idea/**/shelf

# Editor directories and files
.vscode/
.history/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local environment files
.env
.env.*

# Ignore local MAUI certificates and keys
*.p12
*.pem

# Ignore packaged installers
*.msi
*.exe
*.zip
*.7z
*.msix

# End of file
