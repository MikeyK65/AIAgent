<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AIAgent.Views.AccountsPage"
             Title="Accounts">

    <Grid Padding="20" RowDefinitions="Auto,*">
        <VerticalStackLayout Spacing="16">
            <VerticalStackLayout Spacing="4">
                <Label Text="Accounts" Style="{StaticResource Headline}" HorizontalTextAlignment="Start" HorizontalOptions="Start" />
                <Label Text="Review the current mailbox mode and the connection state for each Outlook account." TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}" />
                <Label Text="{Binding StatusText}" />
            </VerticalStackLayout>

            <HorizontalStackLayout Spacing="12">
                <Button Text="Refresh account state" Command="{Binding RefreshCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                            <Setter Property="Text" Value="Refreshing..." />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Accounts}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="16" Margin="0,0,0,12" StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding DisplayName}" FontAttributes="Bold" FontSize="18" />
                            <Label Text="{Binding Address}" />
                            <Label Text="{Binding ProviderName}" />
                            <Label Text="{Binding AccountType}" />
                            <Label Text="{Binding Status}" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
                            <Label Text="{Binding StatusDetail}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
