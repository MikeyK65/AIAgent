<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AIAgent.Views.AzureDevOpsActivityPage"
             Title="Azure DevOps">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Refresh" Command="{Binding RefreshCommand}" Priority="0" Order="Primary" />
    </ContentPage.ToolbarItems>

    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="16">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Azure DevOps activity" Style="{StaticResource Headline}" HorizontalTextAlignment="Start" HorizontalOptions="Start" />
                    <Label Text="Load recent pull request and build activity from the Azure DevOps project link configured in Settings." TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}" />
                    <Label Text="{Binding StatusText}" />
                    <Label Text="{Binding LastRefreshText}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                </VerticalStackLayout>

                <HorizontalStackLayout Spacing="12">
                    <Button Text="Open configured link" Command="{Binding OpenSourceCommand}" IsVisible="{Binding HasSourceLink}" />
                    <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Border Padding="16" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Summary" FontAttributes="Bold" FontSize="18" />
                        <Label Text="{Binding SummaryText}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Recent activity" FontAttributes="Bold" FontSize="18" />

                <Label Text="No Azure DevOps activity is available yet. Save a project link and token in Settings, then refresh this page." IsVisible="{Binding HasNoActivities}" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Activities}" Spacing="12">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="16" StrokeShape="RoundRectangle 16">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="18" />
                                    <Label Text="{Binding Context}" FontAttributes="Bold" />
                                    <Label Text="{Binding Description}" LineBreakMode="WordWrap" />
                                    <Label Text="{Binding OccurredText}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
